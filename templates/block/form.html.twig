{% extends 'base.html.twig' %}
{% block title %}{{ block.id ? 'Редактирование блока' : 'Новый блок' }} — Muse{% endblock %}
{% block body %}<a class="back-link" href="{{ path('app_tasks', block.id ? {block: block.id} : {}) }}">← Назад</a><div class="narrow"><p class="eyebrow">ПОРЯДОК В ДЕЛАХ</p><h1>{{ block.id ? 'Редактирование блока' : 'Новый блок' }}</h1><p class="muted">Объедините задачи по проекту, теме или области жизни.</p><section class="panel form-panel">{{ form_start(form, {attr: {class: 'stack'}}) }}{{ form_widget(form) }}<button class="button" type="submit">Сохранить блок</button>{{ form_end(form) }}</section>{% if block.id %}<details class="danger-zone"><summary>Удаление блока</summary><p>Блок и все его задачи, чек-листы, вложения и ссылки будут удалены без возможности восстановления.</p><form method="post" action="{{ path('app_block_delete', {id: block.id}) }}" data-confirm="Удалить блок со всеми задачами, чек-листами, файлами и ссылками? Это действие нельзя отменить."><input type="hidden" name="_token" value="{{ csrf_token('delete-block' ~ block.id) }}"><button class="button danger" type="submit">Удалить блок</button></form></details>{% endif %}</div>{% endblock %}
