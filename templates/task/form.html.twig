{% extends 'base.html.twig' %}
{% block title %}{{ title }} — Muse{% endblock %}
{% block body %}
<a class="back-link" href="{{ task.id ? path('app_task_show', {id: task.id}) : path('app_tasks', task.block ? {block: task.block.id} : {}) }}">← Назад</a>
<div class="narrow"><p class="eyebrow">ОДНО ДЕЛО ЗА ДРУГИМ</p><h1>{{ title }}</h1>
<section class="panel form-panel">{{ form_start(form, {attr: {class: 'stack'}}) }}{{ form_row(form.title) }}{{ form_row(form.description) }}
<div class="deadline-field" data-deadline-field>
    {{ form_label(form.deadline) }}
    <div class="deadline-input-wrap">
        {{ form_widget(form.deadline, {attr: {'aria-describedby': form.deadline.vars.id ~ '_help'}}) }}
        <button class="deadline-picker-trigger" type="button" data-deadline-open aria-label="Выбрать дату и время" title="Выбрать дату и время" aria-haspopup="dialog" aria-controls="deadline-picker" hidden>
            <span>Выбрать дату и время</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M7 3v4M17 3v4M3 11h18M7 15h3M14 15h3"/></svg>
        </button>
    </div>
    {{ form_errors(form.deadline) }}
    {{ form_help(form.deadline) }}
</div>
{% if form.completed is defined %}{{ form_row(form.completed) }}{% endif %}
{% include 'task/_priority_picker.html.twig' with {priority: form.priority} only %}
{{ form_widget(form) }}<div class="actions"><button class="button" type="submit">Сохранить задачу</button><a class="button quiet" href="{{ path('app_tasks', task.block ? {block: task.block.id} : {}) }}">Отмена</a></div>{{ form_end(form) }}</section></div>
{% include 'task/_deadline_picker.html.twig' %}
{% endblock %}
