{% extends 'base.html.twig' %}
{% block title %}{{ task.title }} — Muse{% endblock %}
{% block body %}
<div class="task-breadcrumbs"><a class="back-link" href="{{ path('app_tasks', {block: task.block.id, status: task.completed ? 'completed' : 'open'}) }}">← {{ task.block.title }}</a></div>
<div class="page-heading"><div><p class="eyebrow">ЗАДАЧА · {{ task.block.title }}</p><h1>{{ task.title }}</h1><span class="badge {{ task.completed ? 'done' : '' }}">{{ task.completed ? '✓ Выполнена' : '○ Активна' }}</span> <span class="badge priority-badge">{{ task.priority is null ? 'Без приоритета' : 'Приоритет: ' ~ task.priority }}</span> {% include 'task/_deadline.html.twig' with {task: task, now: now} only %}</div><div class="actions"><a class="button secondary" href="{{ path('app_task_edit', {id: task.id}) }}">Редактировать</a><form method="post" action="{{ path('app_task_toggle', {id: task.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ task.id) }}"><button class="button" type="submit">{{ task.completed ? 'Открыть снова' : '✓ Завершить' }}</button></form></div></div>
<div class="detail-grid"><div class="stack">
<section class="panel content-panel"><h2>Описание</h2><div class="description">{{ task.description ?: 'Добавьте детали, чтобы ничего не упустить.' }}</div></section>
<section class="panel content-panel">{% include 'task/_checklist.html.twig' with {task: task, public_access: false, context: 'task', form: checklist_form} only %}</section>
<section class="panel content-panel"><h2>Файлы <span class="count">{{ task.attachments|length }}</span></h2>{% include 'task/_files.html.twig' with {task: task, public_access: false} %}<div class="upload-box">{{ form_start(upload_form, {attr: {class: 'stack'}}) }}{{ form_widget(upload_form) }}<button class="button secondary" type="submit">Прикрепить файлы</button>{{ form_end(upload_form) }}</div></section>
</div><aside class="stack">
<section class="panel content-panel share-panel"><span class="large-symbol" aria-hidden="true">↗</span><h2>Поделиться задачей</h2><p class="muted">Ссылка откроет задачу, её чек-лист и файлы на 24 часа. Только просмотр, без регистрации.</p><form method="post" action="{{ path('app_share_create', {id: task.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('share' ~ task.id) }}"><button class="button full" type="submit">Создать ссылку</button></form>
{% for share in shares %}<div class="share-item"><div><strong>Ссылка №{{ share.id }}</strong><small>{% if share.revokedAt %}Отозвана{% elseif not share.active(now) %}Срок истёк{% else %}До {{ share.expiresAt|date('d.m.Y H:i', 'Europe/Moscow') }} МСК{% endif %}</small></div>{% if share.active(now) %}<form method="post" action="{{ path('app_share_revoke', {id: share.id}) }}" data-confirm="Отозвать ссылку? Доступ по ней сразу прекратится."><input type="hidden" name="_token" value="{{ csrf_token('revoke' ~ share.id) }}"><button class="button quiet small danger-text" type="submit">Отозвать</button></form>{% endif %}</div>{% endfor %}
</section>
<section class="meta-panel"><p>Создана {{ task.createdAt|date('d.m.Y H:i', 'Europe/Moscow') }} МСК</p><p>Изменена {{ task.updatedAt|date('d.m.Y H:i', 'Europe/Moscow') }} МСК</p></section>
<details class="danger-zone"><summary>Удаление задачи</summary><p>Задача, её чек-лист, файлы и ссылки будут удалены без возможности восстановления.</p><form method="post" action="{{ path('app_task_delete', {id: task.id}) }}" data-confirm="Удалить задачу вместе с чек-листом, файлами и ссылками? Это действие нельзя отменить."><input type="hidden" name="_token" value="{{ csrf_token('delete-task' ~ task.id) }}"><button class="button danger" type="submit">Удалить задачу</button></form></details>
</aside></div>
{% endblock %}
