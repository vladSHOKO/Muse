{% extends 'base.html.twig' %}
{% set public_view = true %}
{% block title %}{{ task.title }} — Доступ по ссылке{% endblock %}
{% block body %}<div class="narrow wide"><div class="share-notice">Только просмотр · Доступ до {{ link.expiresAt|date('d.m.Y H:i:s', 'Europe/Moscow') }} МСК</div><p class="eyebrow">С ВАМИ ПОДЕЛИЛИСЬ ЗАДАЧЕЙ</p><h1>{{ task.title }}</h1><span class="badge {{ task.completed ? 'done' : '' }}">{{ task.completed ? '✓ Выполнена' : '○ Активна' }}</span> {% include 'task/_deadline.html.twig' with {task: task, now: now} only %}<div class="stack shared-content"><section class="panel content-panel"><h2>Описание</h2><div class="description">{{ task.description ?: 'Описание не добавлено.' }}</div><h2 class="spaced">Файлы</h2>{% include 'task/_files.html.twig' with {task: task, public_access: true, token: token} only %}</section><section class="panel content-panel">{% include 'task/_checklist.html.twig' with {task: task, public_access: true} only %}</section></div></div>{% endblock %}
